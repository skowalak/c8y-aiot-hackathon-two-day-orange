# NOTE: c8y-nitro's generated Docker build uses the PROJECT ROOT as its build
# context and its Dockerfile does `COPY .output/ .output/`, so .output must NOT
# be excluded here. Keep out only heavy/irrelevant/secret paths.

node_modules
.nitro
.data
dist
docker

# secrets — never send to the build context
.env
.env.local

# vcs / tooling / other stacks
.git
simulator
docs
test
result
result-*
.claude-token
.DS_Store
